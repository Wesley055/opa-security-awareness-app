{
  "cli": {
    "version": ">= 21.7.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "OPA_ENVIRONMENT": "staging"
      },
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "OPA_API_BASE_URL": "https://opa-api-production-g4f6cxdyanfbaub0.southafricanorth-01.azurewebsites.net",
        "OPA_ENVIRONMENT": "production",
        "OPA_ENDPOINT_POLICY_FILE": "../../packages/environment-policy/release/production-endpoint.json"
      },
      "environment": "production"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "OPA_ENVIRONMENT": "development"
      }
    }
  }
}
