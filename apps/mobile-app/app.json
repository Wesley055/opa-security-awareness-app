{
  "expo": {
    "name": "OPA",
    "slug": "opa",
    "scheme": "opa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opasafety.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.opasafety.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OPA uses your location when you trigger an emergency alert so your chosen contacts can see where you are, and continues while the alert is open.",
          "locationAlwaysAndWhenInUsePermission": "OPA keeps sharing your location while an emergency alert is open, even when the app is closed or your screen is off, so your contacts can follow where you are until you mark yourself safe.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": null,
      "apiPort": 3000,
      "router": {},
      "eas": {
        "projectId": "51a845d4-1e71-4e55-baa7-8c696faf7023"
      }
    },
    "owner": "opa-technologies"
  }
}
